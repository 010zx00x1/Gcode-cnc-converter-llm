  "cycles": {
    "G80": {
      "siemens": null,
      "action": "cancel_cycle",
      "notes": "Cancelar ciclo - en Siemens los ciclos no quedan activos, se omite G80"
    },
    "G81": {
      "siemens": "CYCLE81",
      "param_map": {
        "R":  "RTP",
        "Z":  "DP",
        "F":  "FDPR",
        "_RFP": 0.0,
        "_SDIS": 2.0
      },
      "signature": "CYCLE81(RTP, RFP, SDIS, DP, DPR)",
      "notes": "Taladrado simple. RFP=plano referencia(0), SDIS=dist seguridad(2mm)"
    },
    "G82": {
      "siemens": "CYCLE82",
      "param_map": {
        "R":  "RTP",
        "Z":  "DP",
        "P":  "DTB",
        "F":  "FDPR",
        "_RFP": 0.0,
        "_SDIS": 2.0
      },
      "signature": "CYCLE82(RTP, RFP, SDIS, DP, DPR, DTB)",
      "notes": "Taladrado con dwell. P en Fanuc es ms, DTB en Siemens es segundos -> dividir /1000"
    },
    "G83": {
      "siemens": "CYCLE83",
      "param_map": {
        "R":  "RTP",
        "Z":  "DP",
        "Q":  "FDEP",
        "F":  "FDPR",
        "_RFP": 0.0,
        "_SDIS": 2.0,
        "_DAM": 0.0,
        "_DTB": 0.0,
        "_DTS": 0.0,
        "_FRF": 1.0,
        "_VARI": 0,
        "_AXN": 0,
        "_MDEP": 0.0,
        "_VRT": 0.0,
        "_DTD": 0.0,
        "_DIS1": 0.0
      },
      "signature": "CYCLE83(RTP, RFP, SDIS, DP, DPR, FDEP, FDPR, DAM, DTB, DTS, FRF, VARI, AXN, MDEP, VRT, DTD, DIS1)",
      "notes": "Peck drilling. FDEP = primer incremento = Q"
    },
    "G84": {
      "siemens": "CYCLE84",
      "param_map": {
        "R":  "RTP",
        "Z":  "DP",
        "F":  "SDAC",
        "_RFP": 0.0,
        "_SDIS": 2.0,
        "_SDIR": 3,
        "_SDAC": 3
      },
      "signature": "CYCLE84(RTP, RFP, SDIS, DP, DPR, DTB, SDAC, MPIT, PIT, POSS, SST, SST1)",
      "notes": "Roscado rigido. SDIR=3 (M3 al bajar). SDAC=3 (M4 al subir)"
    },
    "G85": {
      "siemens": "CYCLE85",
      "param_map": {
        "R":  "RTP",
        "Z":  "DP",
        "F":  "FDPR",
        "_RFP": 0.0,
        "_SDIS": 2.0,
        "_FDPRA": null
      },
      "signature": "CYCLE85(RTP, RFP, SDIS, DP, DPR, DTB, FDPR, FDPRA)",
      "notes": "Escariado. FDPRA = feed retract, si null = mismo que FDPR"
    }
  },

